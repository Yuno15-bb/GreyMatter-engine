        "captured_at": "2026-08-16",
        "validated": true
      },
      "steps": [
        "distillation"
      ],
      "expected": {
        "kind_final": "internal_experience",
        "validated_final": false,
        "preserved_sources": 3,
        "web_still_present": true,
        "depth": 1
      }
    },
    {
      "id": "P4-user-decision-is-not-revalidated",
