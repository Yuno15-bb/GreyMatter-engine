#!/usr/bin/env bash
# brain — point d'entrée unique du C Brain.
# Usage : brain <status|doctor|audit|push|metrics|selftest|backup>
set -euo pipefail
BRAIN="$HOME/.c-brain/trunk"
cd "$BRAIN"

cmd="${1:-status}"
case "$cmd" in
  status)
    python3 hooks/brain_status.py show 2>/dev/null || cat state/status.json 2>/dev/null || echo "(pas de statut)"
    ;;
  doctor)
    python3 hooks/brain_doctor.py "${@:2}"
    ;;
  audit)
    # état OPÉRATIONNEL du pipeline : qu'est-ce qui est distillé / en file / non capté + santé
    python3 hooks/brain_audit.py "${@:2}"
    ;;
  review)
    # AUDIT GLOBAL du tronc (contenu/topologie) : agrège topology + utility +
    # challenger + doctor + fiches périmées + chemins infra → state/review.{json,md}
    python3 hooks/brain_review.py "${@:2}"
    ;;
  recall|search)
    python3 hooks/brain_recall.py "${@:2}"
    ;;
  embed)
    # (re)construire l'index embeddings sémantiques (backend optionnel)
    if [ -x .venv/bin/python ]; then .venv/bin/python hooks/brain_embed.py build; else echo "venv embeddings absent (BM25 par défaut)"; fi
    ;;
  next|reprises)
    python3 hooks/brain_anticipate.py
    ;;
  utility|usage)
    python3 hooks/brain_utility.py "${@:2}"
    ;;
  coherence)
    # paires de fiches à fort recouvrement en attente d'arbitrage par le jardinier
    if [ -f state/coherence.json ]; then python3 -m json.tool state/coherence.json; else echo "✅ aucune paire en attente"; fi
    ;;
  metrics)
    # dernières tendances (10 derniers relevés)
    if [ -f state/metrics.jsonl ]; then tail -10 state/metrics.jsonl; else echo "(pas encore de métriques)"; fi
    ;;
  credit|quota)
    # « est-ce que les agents peuvent dépenser MAINTENANT ? » — sonde d'un token
    # (~0,00003 $) qui interroge l'API au lieu de deviner. `--debloquer` efface un
    # marqueur de blocage devenu faux (plafond rechargé, compte changé).
    if [ "${2:-}" = "--debloquer" ]; then
      python3 -c "
import json, sys, time
sys.path.insert(0, 'hooks')
import quota_probe as qp
v = qp.sonde()
if not v['ok']:
    print('⚠️  la sonde dit NON —', v['motif']); print('   marqueur laissé en place.'); raise SystemExit(7)
json.dump({'blocked_until': 0, 'famille': None, 'echecs': 0, 'msg': 'ok — débloqué à la main',
           'empreinte': v['empreinte'], 'derniere_sonde': v['ts'], 'limites': v['limites']},
          open('state/quota.json', 'w'))
print('✅ blocage levé — les agents peuvent repartir (vérifié par sonde, HTTP', str(v['http']) + ')')
"
    else
      python3 hooks/quota_probe.py
      python3 -c "
import json, time
try: q = json.load(open('state/quota.json'))
except Exception: raise SystemExit
b = q.get('blocked_until', 0)
if b and time.time() < b:
    print()
    print('⛔ maintenance GELÉE localement jusqu\'à', time.strftime('%d/%m %H:%M', time.localtime(b)))
    print('   motif :', str(q.get('msg', ''))[:100])
    print('   la sonde retentera seule (≤ 15 min) — ou : brain credit --debloquer')
"
    fi
    ;;
  push|backup)
    git add -A
    git commit -q -m "backup manuel via brain $(date +%F\ %H:%M)" || echo "(rien à committer)"
    git push --quiet origin main && echo "✅ poussé sur origin/main" || echo "⚠️ push échoué (remote ?)"
    ;;
  selftest)
    bash hooks/selftest.sh
    ;;
  update)
    # Mise à jour du MOTEUR uniquement. Le tronc — tes fiches — n'est jamais touché.
    bash "$HOME/.c-brain/engine/cbrain/update.sh" "${@:2}"
    ;;
  demo)
    # Trois fiches d'exemple, posées puis retirées à la demande. Un tronc
    # vide au premier lancement ne montre rien de ce que l'outil sait faire.
    bash "$HOME/.c-brain/engine/cbrain/demo.sh" "${@:2}"
    ;;
  version)
    cat "$HOME/.c-brain/VERSION" 2>/dev/null || echo "(version inconnue)"
    ;;
  *)
    echo "Usage : brain <status|doctor|audit|review|recall|next|coherence|utility|credit|embed|push|metrics|selftest|backup|update|demo|version>"
    echo "        (update est AUTOMATIQUE à chaque session — --auto-off pour le couper)"
    echo "        (credit : les agents peuvent-ils dépenser ? — --debloquer lève un blocage devenu faux)"
    echo "        (recall accepte --semantic pour le backend embeddings, --lignes pour les passages au lieu des descriptions)"
    exit 1
    ;;
esac
