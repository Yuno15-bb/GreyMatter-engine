#!/usr/bin/env bash
# brain — the single entry point of C Brain.
# Usage : brain <status|doctor|audit|push|metrics|selftest|backup>
set -euo pipefail
BRAIN="$HOME/.c-brain/trunk"
cd "$BRAIN"

cmd="${1:-status}"
case "$cmd" in
  status)
    python3 hooks/brain_status.py show 2>/dev/null || cat state/status.json 2>/dev/null || echo "(no status)"
    ;;
  doctor)
    python3 hooks/brain_doctor.py "${@:2}"
    ;;
  audit)
    # OPERATIONAL state of the pipeline: what is distilled / queued / uncaptured + health
    python3 hooks/brain_audit.py "${@:2}"
    ;;
  review)
    # GLOBAL audit of the trunk (content/topology): aggregates topology + utility +
    # challenger + doctor + stale notes + infrastructure paths → state/review.{json,md}
    python3 hooks/brain_review.py "${@:2}"
    ;;
  recall|search)
    python3 hooks/brain_recall.py "${@:2}"
    ;;
  embed)
    # (re)build the semantic embeddings index (optional backend)
    if [ -x .venv/bin/python ]; then .venv/bin/python hooks/brain_embed.py build; else echo "embeddings venv missing (BM25 by default)"; fi
    ;;
  next|reprises)
    python3 hooks/brain_anticipate.py
    ;;
  utility|usage)
    python3 hooks/brain_utility.py "${@:2}"
    ;;
  coherence)
    # heavily overlapping note pairs awaiting the gardener's arbitration
    if [ -f state/coherence.json ]; then python3 -m json.tool state/coherence.json; else echo "✅ no pending pair"; fi
    ;;
  metrics)
    # latest trends (last 10 readings)
    if [ -f state/metrics.jsonl ]; then tail -10 state/metrics.jsonl; else echo "(no metrics yet)"; fi
    ;;
  credit|quota)
    # "can the agents spend RIGHT NOW?" — a one-token probe (~$0.00003) that asks
    # the API instead of guessing. `--unblock` clears a block marker that has become
    # false (cap topped up, account switched).
    if [ "${2:-}" = "--unblock" ]; then
      python3 -c "
import json, sys, time
sys.path.insert(0, 'hooks')
import quota_probe as qp
v = qp.probe()
if not v['ok']:
    print('⚠️  the probe says NO —', v['reason']); print('   marker left in place.'); raise SystemExit(7)
json.dump({'blocked_until': 0, 'family': None, 'failures': 0, 'msg': 'ok — unblocked by hand',
           'fingerprint': v['fingerprint'], 'last_probe': v['ts'], 'limits': v['limits']},
          open('state/quota.json', 'w'))
print('✅ block lifted — the agents can start again (verified by probe, HTTP', str(v['http']) + ')')
"
    else
      python3 hooks/quota_probe.py
      python3 -c "
import json, time
try: q = json.load(open('state/quota.json'))
except Exception: raise SystemExit
b = q.get('blocked_until', 0)
if b and time.time() < b:
    print()
    print('⛔ maintenance FROZEN locally until', time.strftime('%d/%m %H:%M', time.localtime(b)))
    print('   reason:', str(q.get('msg', ''))[:100])
    print('   the probe will retry on its own (≤ 15 min) — or: brain credit --unblock')
"
    fi
    ;;
  push|backup)
    # ⚠️ THE NAME OVERPROMISES, and the wording below is what corrects it: this
    # records a local HISTORY, on this disk. It is not an off-machine backup, and
    # calling it one would let someone lose a laptop believing otherwise.
    #
    # It used to run `git add -A` straight away. On a trunk nobody had `git init`ed
    # — the state a default install was left in — that printed
    # "fatal: not a git repository" and exited 128: the command whose name promises
    # safekeeping answered with a git error and no instruction.
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
      echo "⚠️  This trunk has no local history: it is not a git repository."
      echo "   Your notes are safe as files — nothing is lost — but nothing records"
      echo "   what changed, and the per-session auto-save has nothing to write to."
      echo "   Turn it on:  git -C \"$BRAIN\" init && brain backup"
      exit 1
    fi
    git add -A
    # `git commit -q` still prints "On branch main / nothing to commit" on its own
    # stdout when there is nothing staged, so the quiet flag is not enough.
    git commit -q -m "manual save via brain $(date +%F\ %H:%M)" >/dev/null 2>&1 \
      || echo "(nothing new to record)"
    echo "✅ recorded in the local history ($(git rev-list --count HEAD) entries, on this disk)"
    # A remote is opt-in and rare: the package never adds one. Staying silent when
    # there is none avoids reporting a failed push to someone who never wanted one.
    if git remote get-url origin >/dev/null 2>&1; then
      git push --quiet origin HEAD && echo "✅ pushed to origin" \
        || echo "⚠️  push to origin failed — the local history is recorded all the same"
    fi
    ;;
  selftest)
    bash hooks/selftest.sh
    ;;
  update)
    # Updates the ENGINE only. The trunk — your notes — is never touched.
    bash "$HOME/.c-brain/engine/cbrain/update.sh" "${@:2}"
    ;;
  demo)
    # Three example notes, placed and taken away on demand. An empty trunk on
    # first launch shows nothing of what the tool can do.
    bash "$HOME/.c-brain/engine/cbrain/demo.sh" "${@:2}"
    ;;
  version)
    cat "$HOME/.c-brain/VERSION" 2>/dev/null || echo "(unknown version)"
    ;;
  *)
    echo "Usage: brain <status|doctor|audit|review|recall|next|coherence|utility|credit|embed|push|metrics|selftest|backup|update|demo|version>"
    echo "        (credit: can the agents spend? — --unblock lifts a block that has become false)"
    echo "       (recall accepts --semantic for the embeddings backend)"
    echo "        (update is AUTOMATIC every session — --auto-off to turn it off)"
    exit 1
    ;;
esac
