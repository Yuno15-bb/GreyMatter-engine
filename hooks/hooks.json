{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/cbrain/plugin_bootstrap.py\"", "timeout": 15 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/brain_anticipate.py\" --hook", "timeout": 10 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/cbrain/check_update.py\"", "timeout": 20 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_recall.py\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/companion/hooks/pre_snapshot.py\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_why": "SESSION LIVENESS. Every other PostToolUse entry matches a SLICE of the tools — Read for one, Write|Edit for the others — so a session spent in Bash, Grep or Task emitted no sign of life at all and the capsule hid the orb mid-work (measured: a status 654 s stale while the session never stopped). This one matches everything on purpose: the question is 'is Claude still working', and any tool running is the answer. It refreshes LIVENESS only, never the activity label.",
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/brain_status.py\" heartbeat", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/on_fiche_write.py\"", "timeout": 15 }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/track_read.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/companion/hooks/post_diff.py\"", "timeout": 8 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/archive_session.py\"", "timeout": 30 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/auto_maintain.py\"", "timeout": 15 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/companion/hooks/session_close.py\"", "timeout": 5 }
        ]
      }
    ]
  }
}
