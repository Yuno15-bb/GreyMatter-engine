<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Project status — the 8 am and 7 pm round.

     WHY A SERVICE AND NOT A SESSION HOOK: the status must be ANNOUNCED morning and
     evening, not found by whoever thinks of opening a session. A hook only talks to whoever
     comes to talk to it.

     NO LLM CALL here — a mechanical round, like the machinist. So it can neither
     cost anything, nor be frozen by the quota, nor fail because a model is unavailable.

     TEMPLATE — __HOME__ must be replaced by the real $HOME at install time.
     A hard-coded path from an old machine already silently broke the Brain's
     resume on 2026-07-22. The marker is `__HOME__`, as in the machinist's
     template: a real path written here would ship as-is in the public package.

     Install:
       sed -e "s|__HOME__|$HOME|g" -e "s|__BRAIN__|$(python3 -c 'import os;print(os.path.realpath(os.path.expanduser("~/.c-brain/trunk")))')|g" \
         hooks/com.claudebrain.etat.plist.template \
         > ~/Library/LaunchAgents/com.claudebrain.etat.plist
       launchctl load -w ~/Library/LaunchAgents/com.claudebrain.etat.plist
     Check (the observable, not the return code):
       launchctl kickstart -k gui/$(id -u)/com.claudebrain.etat
       tail -5 ~/.c-brain/trunk/sessions/status.log          → the announcement must be there
       head -8 ~/.c-brain/trunk/projects/project-status.md   → timestamp of the pass
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudebrain.etat</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/.c-brain/trunk/hooks/etat_projets.py</string>
        <string>--notify</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- I-3 (2026-08-20): the Brain's identity is PASSED ON, it is not guessed.
             Without this variable, the child falls back on the default trunk — the
             current user's — whatever Brain this service is meant to
             serve. An absolute path in ProgramArguments designates the CODE to run,
             never the Brain to measure: measured on 2026-08-20 on 18 session hooks,
             all invoked by absolute path, none anchored anything.
             `__BRAIN__` is rendered as the CANONICAL root (realpath) at install time,
             not as `__HOME__/.c-brain/trunk`: the ~/.claude/projects/…/memory symlink
             gives two paths for a single tree. -->
        <key>BRAIN_HOME</key>
        <string>__BRAIN__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- Two passes: the morning check, the evening review. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>8</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>19</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>
    <!-- The Mac is often asleep at 8 am: without this, the missed pass would be lost.
         launchd replays it on wake. -->
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.c-brain/trunk/sessions/status.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.c-brain/trunk/sessions/status.log</string>
</dict>
</plist>
