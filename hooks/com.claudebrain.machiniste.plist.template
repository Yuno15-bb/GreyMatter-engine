<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Machiniste — ronde machine du Claude Brain (RAM / CPU / chaleur).
     Toutes les 10 minutes, sans LLM : mesure, tue les serveurs de dev orphelins,
     signale le reste. Coût quota : zéro.

     TEMPLATE — __HOME__ doit être substitué par le vrai $HOME à l'installation
     (même piège que com.claudebrain.resume : un /Users/<ancien-nom> en dur avait cassé
     silencieusement la reprise sur machine neuve le 2026-07-22). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudebrain.machiniste</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/.c-brain/trunk/hooks/machiniste.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- I-3 (2026-08-20) : l'identité du Brain se TRANSMET, elle ne se devine pas.
             Sans cette variable, l'enfant retombe sur ~/claude-brain — le tronc de
             l'utilisateur courant — quel que soit le Brain que ce service est censé
             servir. Un chemin absolu dans ProgramArguments désigne le CODE à exécuter,
             jamais le Brain à mesurer : mesuré le 2026-08-20 sur 18 hooks de session,
             tous invoqués par chemin absolu, aucun n'ancrait quoi que ce soit.
             `__BRAIN__` est rendu par la racine CANONIQUE (realpath) à l'installation,
             et non par `__HOME__/.c-brain/trunk` : le symlink ~/.claude/projects/…/memory
             donne deux chemins pour un seul arbre. -->
        <key>BRAIN_HOME</key>
        <string>__BRAIN__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <!-- Nice bas : la ronde ne doit jamais disputer le CPU au travail de l'utilisateur. -->
    <key>Nice</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.c-brain/trunk/sessions/machiniste.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.c-brain/trunk/sessions/machiniste.log</string>
</dict>
</plist>
